# ==========================================
# Production-Grade .gitignore (MNC Standard)
# React / TypeScript / Vite / Node.js
# ==========================================

# ------------------------------------------
# Environment & Secrets (Zero Secret Exposure)
# ------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt

# ------------------------------------------
# Dependencies
# ------------------------------------------
node_modules/
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------
# Production Build & Compilation Artifacts
# ------------------------------------------
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
.vite/

# ------------------------------------------
# Testing & Coverage
# ------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/

# ------------------------------------------
# Runtime Logs & Diagnostics
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# IDE, Editors & Tooling
# ------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# ------------------------------------------
# OS Generated Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# Temporary & Scratch Dirs
# ------------------------------------------
tmp/
temp/
scratch/
